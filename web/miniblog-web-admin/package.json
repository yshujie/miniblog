{
  "name": "vue3-element-admin",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:test": "vite --mode dev_test",
    "dev:prod": "vite --mode dev_prod",
    "build:test": "vite build --mode build_test",
    "build:prod": "vite build --mode build_prod",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint:check": "eslint src/api/content.ts src/api/content.test.ts src/api/article.js src/components/content src/composables src/stores src/store/index.ts src/store/modules/module.ts src/store/modules/section.ts src/store/modules/subsection.ts src/store/modules/contentWorkspace.ts src/store/modules/section.test.ts src/store/modules/subsection.test.ts src/types/content.ts src/utils/api-error.ts src/utils/content-flags.ts src/utils/content-flags.test.ts src/utils/request.js src/router/index.ts src/views/content src/views/article src/views/home/index.vue src/views/section/index.vue src/views/subsection/index.vue vite.config.ts vitest.config.ts scripts/browser-fixture.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "build": "vite build --mode build_prod",
    "test:browser:fixture": "node scripts/browser-fixture.mjs"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "element-plus": "^2.10.5",
    "fuse.js": "^6.6.2",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.2.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@pivanov/vite-plugin-svg-sprite": "^3.1.3",
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.10.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^26.1.0",
    "mockjs": "^1.1.0",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "6.4.0",
    "vite-plugin-inspect": "^11.3.2",
    "vite-plugin-mock": "^2.9.8",
    "vitest": "5.0.3",
    "vue-tsc": "^3.0.4"
  }
}
